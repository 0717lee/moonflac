///|
test "Symmetric variance independent Fraction full matrix numerical contract" {
  {
    let result = encoder_lpc_variance(
      [32.0, 16.0],
      { coefficients: [1L], shift: 0, precision: 15, },
      4294967296.0,
      65535.0,
    )
    assert_true(result is Some(_))
    if result is Some(value) {
      assert_true((value - 9007336695791648.0).abs() <= 1826.1078641948282)
    }
  }
  {
    let result = encoder_lpc_variance(
      [32.0, 16.0],
      { coefficients: [1L], shift: 8, precision: 15, },
      4294967296.0,
      65535.0,
    )
    assert_true(result is Some(_))
